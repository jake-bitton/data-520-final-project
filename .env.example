# Copy to .env and edit. All settings are optional; these are the defaults.

LLM_BASE_URL=http://127.0.0.1:11434/v1   # 127.0.0.1, not localhost (avoids a ~2s IPv6 retry on Windows); vLLM: http://127.0.0.1:8001/v1
LLM_API_KEY=ollama                       # placeholder, ignored locally
LLM_MODEL=gpt-oss:20b                    # vLLM: openai/gpt-oss-20b
LLM_SERVER=ollama                        # ollama | vllm | llamacpp (logged per run)
LLM_MODE=fake                            # real | fake  (fake needs no model)
REASONING_FIELDS=reasoning,reasoning_content   # confirm in the Phase 0 smoke test
REASONING_IN_SYSTEM_PROMPT=false         # true if the server ignores reasoning_effort
REASONING_EFFORT=medium                  # low | medium | high
DEFAULT_TEMPERATURE=1.0                  # gpt-oss model card recommendation (verify)
DEFAULT_MAX_TOKENS=4000
DEFAULT_K=5
MAX_CONCURRENT_GENERATIONS=1
LLM_TIMEOUT_S=300
PROMPT_VERSION=v0_placeholder

# Fake mode behaviour: normal | fail | truncate | empty
FAKE_BEHAVIOR=normal
FAKE_DELAY_S=0.02

# Used by the Streamlit UI
API_URL=http://127.0.0.1:8000
